        "better-auth": "1.7.22",
        "drizzle-orm": "0.45.4",
        "hono": "4.13.18",
        "postgres": "3.4.9",
        "zod": "4.6.7"
    },
    "devDependencies": {
        "@types/bun": "1.4.4",
        "drizzle-kit": "0.31.11",
        "typescript": "5.9.3"
    }
}